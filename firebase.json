{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "compy-tcc",
          "appId": "1:260166625635:android:d3a540c67965084979cb56",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "compy-tcc",
          "configurations": {
            "android": "1:260166625635:android:d3a540c67965084979cb56",
            "ios": "1:260166625635:ios:d62c9231b41ba05179cb56",
            "web": "1:260166625635:web:c6f717d9c7d38c4f79cb56"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "administrative",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "database": "(default)",
    "location": "southamerica-east1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "admin",
      "public": "admin/build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=0, must-revalidate"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Compy",
        "supportEmail": "gabrielfernandespitta@gmail.com"
      }
    }
  }
}
