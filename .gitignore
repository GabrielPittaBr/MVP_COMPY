# Firebase
# Client configuration generated by FlutterFire is versioned so a fresh clone
# can build. It is not a server credential; access is protected by Firebase
# Authentication, Firestore Rules and API restrictions. Never commit service
# accounts, Admin SDK keys, private keys or .env files with server secrets.
.agents/

# Infraestrutura confiável Firebase (Functions e scripts Admin SDK).
# Credenciais devem ser fornecidas externamente por Application Default
# Credentials ou GOOGLE_APPLICATION_CREDENTIALS; nunca por arquivos no repo.
functions/.env
functions/.env.*
functions/lib/
tools/firebase-admin/.env
tools/firebase-admin/.env.*
tools/firebase-admin/lib/
serviceAccountKey.json
service-account*.json
firebase-adminsdk-*.json
*-firebase-adminsdk-*.json
app-check-debug-token*
*.pem
*.p12

# Emuladores do Firebase (logs e dados exportados)
*-debug.log
firebase-export-*/
.firebase/

