rules_version = '2';

// Regras de segurança do Firestore — COMPY.
//
// Estratégia: `signedIn()` autoriza **o app**, não **o usuário certo**. Como o
// app já tem uid real em todo lugar, cada coleção é restringida ao papel de
// quem escreve (dono do perfil, criador do evento, membro da conversa).
//
// Base: docs/roadmap-prioridade-alta.md → "Regras do Firestore — trabalho
// pendente". Cada bloco abaixo referencia a tarefa que o originou.
//
// Convenção deste arquivo:
//   - `delete` é negado por padrão, com exceções explícitas. Na exclusão de conta:
//     o dono apaga o próprio `users/{uid}`, o `private/contact`, as próprias
//     notificações (`users/{uid}/notifications`) e a reserva em
//     `usernames/{username}`. `friendships` também permite exclusão pelos
//     participantes, nas condições específicas de cancelamento/remoção.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    /// Chaves que mudaram entre o estado atual e o escrito.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── Proteções da LGPD e do ECA Digital (chore/lgpd) ─────────────────
    // `get()` e `exists()` nas regras leem qualquer documento, sem passar
    // pelas regras dele: é o que deixa a data de nascimento e os bloqueios
    // privados e, mesmo assim, valendo para todo mundo.

    function consentPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/private/consent;
    }

    /// Conta de 16 ou 17 anos, pela data declarada ou pela faixa que a
    /// Google Play informou. Sem o documento (contas anteriores ao aceite,
    /// que o app leva para /consentimento), vale como adulto: senão o app
    /// antigo perderia o chat de todo mundo de uma vez.
    function isMinor(uid) {
      return exists(consentPath(uid))
          && (get(consentPath(uid)).data.adultAt > request.time
              || get(consentPath(uid)).data.get('ageSignal', {})
                   .get('upper', 99) < 18);
    }

    /// Amizade aceita. O id do par é `{menor}:{maior}`; as regras não têm
    /// como ordenar, então olham as duas ordens — só uma existe.
    function areFriends(a, b) {
      return (exists(/databases/$(database)/documents/friendships/$(a + ':' + b))
              && get(/databases/$(database)/documents/friendships/$(a + ':' + b))
                   .data.status == 'accepted')
          || (exists(/databases/$(database)/documents/friendships/$(b + ':' + a))
              && get(/databases/$(database)/documents/friendships/$(b + ':' + a))
                   .data.status == 'accepted');
    }

    /// `a` bloqueou `b`.
    function hasBlocked(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocks/$(b));
    }

    /// Duas pessoas podem conversar: nenhuma bloqueou a outra e, se uma
    /// delas tem 16 ou 17 anos, são amigas (ECA Digital, art. 17, §4º, I).
    function canTalk(a, b) {
      return !hasBlocked(a, b) && !hasBlocked(b, a)
          && ((!isMinor(a) && !isMinor(b)) || areFriends(a, b));
    }

    // ── users ────────────────────────────────────────────────────────
    // Tarefa 13. Perfis públicos: qualquer autenticado lê, só o dono escreve
    // o seu. `hasOnly` impede que o cliente despeje campos arbitrários no
    // documento (inclusive médias de avaliação forjadas — ver `ratings`).
    //
    // O e-mail **não** mora aqui: `read: if signedIn()` o entregaria a
    // qualquer autenticado, contrariando a RN-06. Ele vive em
    // `users/{uid}/private/contact`, no bloco aninhado no fim deste match.
    //
    // `nameLower` entra no contrato novo de pesquisa administrativa. A fase
    // transitória ainda aceita perfis legados sem ele, mas todo perfil novo o
    // recebe e um perfil que já o possui não pode removê-lo. O normalizador
    // pt-BR exato fica no cliente e no script confiável: Rules validam forma e
    // que uma troca de nome resulte em um `nameLower` presente.
    match /users/{userId} {
      function validProfile() {
        return request.resource.data.keys().hasOnly(
                 ['id', 'name', 'nameLower', 'handle', 'avatarUrl', 'createdAt',
                  'favoriteSports', 'bio'])
            && request.resource.data.id == userId
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 60
            && validOptionalNameLower()
            && request.resource.data.handle is string
            && request.resource.data.handle.size() <= 21
            && validFavoriteSports()
            && (!('bio' in request.resource.data.keys())
                || (request.resource.data.bio is string
                    && request.resource.data.bio.size() <= 160))
            && validOptionalAvatarUrl();
      }

      // Foto de perfil: URL do Storage, do Google ou o placeholder com a
      // inicial — sempre um endereço web. `https?` porque o emulador do
      // Storage serve em http (`http://localhost:9199/...`).
      function validOptionalAvatarUrl() {
        return !('avatarUrl' in request.resource.data.keys())
            || (request.resource.data.avatarUrl is string
                && request.resource.data.avatarUrl.size() <= 2048
                && request.resource.data.avatarUrl.matches('^https?://.+'));
      }

      function hasValidNameLower() {
        return 'nameLower' in request.resource.data.keys()
            && request.resource.data.nameLower is string
            && request.resource.data.nameLower.size() > 0
            && request.resource.data.nameLower.size() <= 60;
      }

      function validOptionalNameLower() {
        return !('nameLower' in request.resource.data.keys())
            || hasValidNameLower();
      }

      function preservesProfileIdentity() {
        return request.resource.data.handle == resource.data.handle
            && request.resource.data.createdAt == resource.data.createdAt;
      }

      function validNameLowerTransition() {
        return (!('nameLower' in resource.data.keys())
                || 'nameLower' in request.resource.data.keys())
            && (request.resource.data.name == resource.data.name
                || hasValidNameLower());
      }

      // Tarefa 13: no máximo 16 esportes (tamanho do enum `Sport`, que passou
      // de 8 para 16 na issue 30), lista de strings — evita que
      // `Sport.values.firstWhere` estoure na leitura. Mudou o enum, muda aqui
      // e em `validSports()` dos locais.
      function validFavoriteSports() {
        return !('favoriteSports' in request.resource.data.keys())
            || (request.resource.data.favoriteSports is list
                && request.resource.data.favoriteSports.size() <= 16);
      }

      allow read: if signedIn();
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && validProfile()
                    && hasValidNameLower();
      allow update: if signedIn()
                    && request.auth.uid == userId
                    && validProfile()
                    && preservesProfileIdentity()
                    && validNameLowerTransition();
      // Exclusão de conta: o dono apaga o próprio perfil. Sem isto, o
      // documento sobrevive à conta e vira registro órfão de gente que
      // pediu para sair.
      allow delete: if signedIn() && request.auth.uid == userId;

      // ── users/{uid}/private ──────────────────────────────────────
      // Tarefa 13 (RN-06). Dados que não podem ser públicos. Subcoleção
      // porque as regras do documento pai não alcançam os filhos: é o que
      // permite o perfil continuar público e estes documentos não.
      //
      // Só o dono lê e escreve, e só os dois documentos conhecidos:
      //   - `contact`: o e-mail, que a exportação de dados devolve;
      //   - `consent` (chore/lgpd): versão e data do aceite dos Termos, data
      //     de nascimento e a faixa etária que a Google Play informou. As
      //     regras de `conversations` o consultam para saber quem tem 16 ou
      //     17 anos.
      match /private/{docId} {
        function validAgeSignal(signal) {
          return signal is map
              && signal.keys().hasAll(['checkedAt'])
              && signal.keys().hasOnly(['lower', 'upper', 'checkedAt'])
              && signal.checkedAt is timestamp
              && (!('lower' in signal) || signal.lower is int)
              && (!('upper' in signal) || signal.upper is int);
        }

        // A idade mínima (16) é conferida aqui também, não só na tela:
        // 5843 dias são 16 anos com 4 dias bissextos. `adultAt` é o 18º
        // aniversário que o app calcula; a janela aceita 18 anos de 6574 a
        // 6575 dias e a folga de quem nasceu em 29/02.
        function validConsent() {
          let data = request.resource.data;
          return data.keys().hasAll(
                   ['termsVersion', 'acceptedAt', 'birthDate', 'adultAt'])
              && data.keys().hasOnly(
                   ['termsVersion', 'acceptedAt', 'birthDate', 'adultAt',
                    'ageSignal'])
              && data.termsVersion is string
              && data.termsVersion.size() > 0
              && data.termsVersion.size() <= 20
              && data.acceptedAt is timestamp
              && data.birthDate is timestamp
              && data.birthDate >= timestamp.date(1900, 1, 1)
              && data.birthDate <= request.time - duration.value(5843, 'd')
              && data.adultAt is timestamp
              && data.adultAt > data.birthDate + duration.value(6570, 'd')
              && data.adultAt < data.birthDate + duration.value(6577, 'd')
              && (!('ageSignal' in data) || validAgeSignal(data.ageSignal));
        }

        function isOwner() {
          return signedIn() && request.auth.uid == userId;
        }

        allow read: if isOwner();
        allow create: if isOwner()
                      && (docId == 'contact'
                          || (docId == 'consent'
                              && validConsent()
                              && request.resource.data.acceptedAt
                                 == request.time));
        // A data de nascimento não muda pelo app: corrigir é pelo canal do
        // encarregado. O aceite muda quando os Termos mudam (nova versão,
        // com a hora do servidor) e a faixa da Play pode ser reconsultada.
        allow update: if isOwner()
                      && (docId == 'contact'
                          || (docId == 'consent'
                              && validConsent()
                              && request.resource.data.birthDate
                                 == resource.data.birthDate
                              && request.resource.data.adultAt
                                 == resource.data.adultAt
                              && (request.resource.data.acceptedAt
                                    == request.time
                                  || (request.resource.data.acceptedAt
                                        == resource.data.acceptedAt
                                      && request.resource.data.termsVersion
                                        == resource.data.termsVersion))));
        allow delete: if isOwner();
      }

      // ── users/{uid}/blocks/{blockedUid} ──────────────────────────
      // chore/lgpd. Quem o dono bloqueou. Só ele vê a lista; as regras de
      // `conversations` e `friendships` a consultam com `exists()`.
      match /blocks/{blockedId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
                      && request.auth.uid == userId
                      && blockedId != userId
                      && request.resource.data.keys().hasOnly(['createdAt'])
                      && request.resource.data.createdAt == request.time;
      }

      // ── users/{uid}/notifications ────────────────────────────────
      // Tarefa 14. Central de notificações in-app. Quem cria é o gatilho
      // `onEventEnded`, e quem marca "Avaliado" é a callable da avaliação,
      // as duas pelo Admin SDK. O dono só lê e marca como lida, uma vez, com
      // o horário do servidor. Na exclusão de conta, ele apaga as suas.
      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow update: if signedIn()
                      && request.auth.uid == userId
                      && resource.data.get('readAt', null) == null
                      && changed().hasOnly(['readAt'])
                      && request.resource.data.readAt == request.time;
        allow delete: if signedIn() && request.auth.uid == userId;
        allow create: if false;
      }
    }

    // ── usernames ────────────────────────────────────────────────────
    // Tarefa 5. Índice de unicidade (doc id = username em minúsculo, dado
    // `{ uid }`).
    //
    // `read: if true` é decisão consciente, não resquício: `isUsernameAvailable()`
    // roda **antes** do login, no formulário de cadastro. O custo é expor a
    // lista de usernames — aceitável, já que username é público por natureza.
    //
    // `update` permitido quando o doc já pertence ao mesmo uid: sem isso o
    // re-cadastro do item 3 da tarefa 5 (`batch.set` sobre doc existente vira
    // update) estoura em PERMISSION_DENIED.
    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      // Exclusão de conta: só o dono da reserva a libera. Sem isto o
      // username fica preso para sempre — `update` exige ser do mesmo uid,
      // e esse uid não existe mais.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ── events ───────────────────────────────────────────────────────
    // Tarefa 12. Antes, qualquer autenticado editava qualquer evento — podia
    // mudar a data de um evento alheio, remover participantes ou inflar as
    // próprias vagas. Agora `update` tem dois caminhos distintos:
    //
    //   1. Criador edita os dados do evento (não pode trocar o dono).
    //   2. Qualquer autenticado entra no evento — e apenas isso: mexe só em
    //      `participants` + `participantIds` + `remainingSpots`, adiciona **a si
    //      mesmo** no fim dos dois arrays (o `arrayUnion` do `join()` sempre
    //      acrescenta ao fim) e decrementa exatamente uma vaga. Isso fecha a
    //      fraude do join apontada em proximos-passos.md: não dá para aumentar
    //      `remainingSpots` sem remover participante, nem vice-versa.
    match /events/{eventId} {
      function isCreator() {
        return signedIn() && resource.data.creator.id == request.auth.uid;
      }

      function ownerUnchanged() {
        return request.resource.data.creator.id == resource.data.creator.id;
      }

      function spotsCoherent() {
        return request.resource.data.remainingSpots >= 0
            && request.resource.data.remainingSpots
               <= request.resource.data.totalSpots;
      }

      function eventPlacePath(placeId) {
        return /databases/$(database)/documents/places/$(placeId);
      }

      function newPlaceSnapshotMatchesCurrentPlace() {
        let place = get(eventPlacePath(request.resource.data.placeId)).data;
        return request.resource.data.placeId is string
            && request.resource.data.placeId.size() > 0
            && request.resource.data.placeSnapshot is map
            && request.resource.data.placeSnapshot.keys().hasAll(
                 ['name', 'address', 'coordinates'])
            && request.resource.data.placeSnapshot.keys().hasOnly(
                 ['name', 'address', 'coordinates'])
            && exists(eventPlacePath(request.resource.data.placeId))
            && place.status == 'active'
            && request.resource.data.sport in place.sports
            && request.resource.data.placeSnapshot.name == place.name
            && request.resource.data.placeSnapshot.address == place.address
            && request.resource.data.placeSnapshot.coordinates is latlng
            && request.resource.data.placeSnapshot.coordinates
               == place.coordinates
            && request.resource.data.coordinates is latlng
            && request.resource.data.coordinates == place.coordinates
            && request.resource.data.geohash is string
            && request.resource.data.geohash.size() == 9
            && request.resource.data.location
               == place.name + ', ' + place.address.city;
      }

      function historicalEventFieldsUnchanged() {
        return !changed().hasAny(['sport', 'placeId', 'placeSnapshot']);
      }

      // `participantIds` é o array de uids que a seção "Participando"
      // consulta (`arrayContains`) — `participants`, sendo array de mapas, não
      // é consultável. Por isso ele entra na regra: se pudesse crescer sozinho,
      // qualquer um se enfiaria na lista de qualquer evento sem ocupar vaga, e
      // o app mostraria eventos alheios como "meus".
      //
      // O `get(..., [])` cobre documentos anteriores à tarefa 12, que não têm
      // o campo: sem o default a expressão estouraria e eles ficariam
      // impossíveis de participar. O primeiro join cria o array.
      function joinedIdsBefore() {
        return resource.data.get('participantIds', []);
      }

      // Tarefa 14 — ciclo de vida. Os três campos só o servidor grava (o
      // criador ao encerrar, a Function `autoEndOverdueEvents` 1h depois do
      // fim previsto e a callable da avaliação), então um evento não pode
      // nascer com eles. O encerramento automático fica com a Function, e não
      // com uma exceção aqui que deixasse qualquer participante gravar
      // `endedAt`.
      function lifecycleFields() {
        return ['endedAt', 'endedAutomatically', 'ratedBy'];
      }

      function isEnded() {
        return resource.data.get('endedAt', null) != null;
      }

      // Documentos anteriores à tarefa 3 não têm `endsAt`; o app assume 1h.
      function plannedEnd() {
        return resource.data.get('endsAt',
                                 resource.data.dateTime + duration.value(60, 'm'));
      }

      // A mesma folga de 1h de `kEventEndTolerance` (app) e da Function:
      // passado o fim previsto + 1h, o evento está encerrado mesmo antes de a
      // Function gravar `endedAt`.
      function withinTolerance() {
        return request.time < plannedEnd() + duration.value(1, 'h');
      }

      // Encerramento manual: só o criador, uma única vez, depois do início e
      // dentro da folga, gravando o horário do servidor e
      // `endedAutomatically = false`. O `true` é exclusivo da Function, e o
      // `ratedBy` da callable da avaliação.
      function isManualEnd() {
        return isCreator()
            && !isEnded()
            && changed().hasOnly(['endedAt', 'endedAutomatically'])
            && request.resource.data.endedAt == request.time
            && request.resource.data.endedAutomatically == false
            && request.time >= resource.data.dateTime
            && withinTolerance();
      }

      // Entrar só enquanto o evento está agendado ou acontecendo: depois do
      // fim, ninguém entra só para poder avaliar.
      function isJoin() {
        return signedIn()
            && changed().hasOnly(
                 ['participants', 'participantIds', 'remainingSpots'])
            && request.resource.data.participants.size()
               == resource.data.participants.size() + 1
            && request.resource.data
                 .participants[resource.data.participants.size()].id
               == request.auth.uid
            && request.resource.data.participantIds.size()
               == joinedIdsBefore().size() + 1
            && request.resource.data
                 .participantIds[joinedIdsBefore().size()] == request.auth.uid
            && request.resource.data.remainingSpots
               == resource.data.remainingSpots - 1
            && request.resource.data.remainingSpots >= 0
            && !isEnded()
            && withinTolerance();
      }

      allow read: if signedIn();
      // Criar evento em nome de outro é negado duas vezes: pelo `creator.id` e
      // pelo `participantIds`, que na criação só pode conter o próprio uid —
      // ninguém inscreve terceiros num evento que acabou de inventar.
      allow create: if signedIn()
                    && request.resource.data.creator.id == request.auth.uid
                    && request.resource.data.participantIds
                       == [request.auth.uid]
                    && request.resource.data.totalSpots is int
                    && request.resource.data.totalSpots > 0
                    && spotsCoherent()
                    && newPlaceSnapshotMatchesCurrentPlace()
                    && !request.resource.data.keys().hasAny(lifecycleFields());
      // O criador edita o evento aberto, sem tocar no ciclo de vida; depois de
      // encerrado, o evento fica congelado para ele.
      allow update: if (isCreator()
                       && !isEnded()
                       && ownerUnchanged()
                       && spotsCoherent()
                       && historicalEventFieldsUnchanged()
                       && !changed().hasAny(lifecycleFields()))
                    || isManualEnd()
                    || isJoin();
      allow delete: if false;
    }

    // Uma única relação privada por par. ':' não faz parte dos UIDs
    // aceitos pelo contrato, evitando colisões na concatenação.
    match /friendships/{pairId} {
      function validUid(uid) {
        return uid is string && uid.matches('^[a-zA-Z0-9_-]{1,128}$');
      }
      function canonical(members) {
        return members is list && members.size() == 2
            && validUid(members[0]) && validUid(members[1])
            && members[0] < members[1]
            && pairId == members[0] + ':' + members[1];
      }
      function validRelation() {
        let d = request.resource.data;
        return d.keys().hasAll(['members', 'senderId', 'status', 'requestedAt'])
            && d.keys().hasOnly(['members', 'senderId', 'status', 'requestedAt', 'acceptedAt'])
            && canonical(d.members) && d.senderId in d.members
            && d.requestedAt is timestamp
            && (d.status == 'pending' && !('acceptedAt' in d)
                || d.status == 'accepted' && d.acceptedAt is timestamp);
      }
      // A transação precisa poder ler um par ainda inexistente. O ID
      // validado restringe essa leitura aos dois envolvidos, sem consulta
      // aberta a documentos de terceiros.
      allow get: if signedIn() && canonical(pairId.split(':'))
                 && request.auth.uid in pairId.split(':');
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      // Bloqueio (chore/lgpd): quem foi bloqueado não pede amizade, e quem
      // bloqueou precisa desbloquear antes de pedir.
      allow create: if signedIn() && validRelation()
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.requestedAt == request.time
                    && !hasBlocked(request.resource.data.members[0],
                                   request.resource.data.members[1])
                    && !hasBlocked(request.resource.data.members[1],
                                   request.resource.data.members[0])
                    && exists(/databases/$(database)/documents/users/$(request.resource.data.members[0]))
                    && exists(/databases/$(database)/documents/users/$(request.resource.data.members[1]));
      allow update: if signedIn() && validRelation()
                    && request.auth.uid in resource.data.members
                    && request.auth.uid != resource.data.senderId
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'accepted'
                    && changed().hasOnly(['status', 'acceptedAt'])
                    && request.resource.data.acceptedAt == request.time
                    && exists(/databases/$(database)/documents/users/$(resource.data.members[0]))
                    && exists(/databases/$(database)/documents/users/$(resource.data.members[1]));
      // Em pending, o remetente cancela e o destinatário recusa. Em
      // accepted qualquer um desfaz. Terceiros nunca apagam.
      allow delete: if signedIn() && request.auth.uid in resource.data.members
                    && resource.data.status in ['pending', 'accepted'];
    }

    // ── conversations / messages ─────────────────────────────────────
    // Tarefa 9. Antes, qualquer autenticado lia e escrevia qualquer conversa
    // privada de qualquer pessoa — o pior default possível num app de chat.
    // O documento já tem o array `members`, então dá para apertar sem perder
    // funcionalidade: a query paginada já filtra por
    // `where('members', arrayContains: userId)`.
    //
    // As mensagens validam a associação com um `get()` no documento pai — custa
    // uma leitura por operação. A alternativa (desnormalizar `members` em cada
    // mensagem) foi descartada por enquanto: exigiria mudar o schema de
    // `sendMessage` e o volume de mensagens do MVP não justifica.
    match /conversations/{conversationId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      function isMemberOfParent() {
        return signedIn()
            && request.auth.uid in get(
                 /databases/$(database)/documents/conversations/$(conversationId)
               ).data.members;
      }

      allow read: if isMember();

      // Só se cria conversa incluindo a si mesmo — ninguém abre conversa entre
      // terceiros. Conversas são 1:1 (a entidade `Conversation` resolve um
      // único `peer`). `canTalk` (chore/lgpd): sem bloqueio entre os dois e,
      // com alguém de 16 ou 17 anos, só entre amigos.
      allow create: if signedIn()
                    && request.resource.data.members is list
                    && request.resource.data.members.size() == 2
                    && request.auth.uid in request.resource.data.members
                    && canTalk(request.resource.data.members[0],
                               request.resource.data.members[1]);

      // Depois de criada, `members` é imutável: só o rodapé da conversa muda.
      allow update: if isMember()
                    && changed().hasOnly(
                         ['lastMessage', 'lastMessageAt', 'unreadCounts']);
      allow delete: if false;

      match /messages/{messageId} {
        function hasActivePlaceForMessage() {
          return request.resource.data.placeId is string
              && request.resource.data.placeId.size() > 0
              && exists(/databases/$(database)/documents/places/$(request.resource.data.placeId))
              && get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.status == 'active';
        }

        function validPlaceMessageSnapshot() {
          return request.resource.data.keys().hasAll(
                   ['senderId', 'text', 'sentAt', 'placeId', 'placeSnapshot'])
              && request.resource.data.keys().hasOnly(
                   ['senderId', 'text', 'sentAt', 'placeId', 'placeSnapshot'])
              && hasActivePlaceForMessage()
              && request.resource.data.placeSnapshot is map
              && request.resource.data.placeSnapshot.keys().hasAll(
                   ['name', 'imageUrl', 'primarySport'])
              && request.resource.data.placeSnapshot.keys().hasOnly(
                   ['name', 'imageUrl', 'primarySport'])
              && request.resource.data.placeSnapshot.name
                 == get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.name
              && request.resource.data.placeSnapshot.imageUrl
                 == get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.imageUrl
              && request.resource.data.placeSnapshot.primarySport
                 == get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.primarySport;
        }

        // A mesma checagem da criação vale para cada mensagem: um bloqueio
        // ou uma amizade desfeita com alguém de 16 ou 17 anos fecham também
        // as conversas que já existiam.
        function parentMembers() {
          return get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.members;
        }

        allow read: if isMemberOfParent();
        allow create: if isMemberOfParent()
                      && canTalk(parentMembers()[0], parentMembers()[1])
                      && request.resource.data.senderId == request.auth.uid
                      && ((!('placeId' in request.resource.data)
                           && !('placeSnapshot' in request.resource.data))
                          || validPlaceMessageSnapshot());
        // Mensagem enviada não se edita nem se apaga.
        allow update, delete: if false;
      }
    }

    // ── places ───────────────────────────────────────────────────────
    // Contrato final de Locais Esportivos. Novos eventos e mensagens de local
    // precisam usar documentos ativos e snapshots validados no commit.
    match /places/{placeId} {
      function validRequiredString(value, maximum) {
        return value is string && value.size() > 0 && value.size() <= maximum;
      }

      function validOptionalAddressString(field, maximum) {
        return !(field in request.resource.data.address)
            || (request.resource.data.address[field] is string
                && request.resource.data.address[field].size() > 0
                && request.resource.data.address[field].size() <= maximum);
      }

      function validAddress() {
        return request.resource.data.address is map
            && request.resource.data.address.keys().hasAll(
                 ['street', 'city', 'cityLower', 'state'])
            && request.resource.data.address.keys().hasOnly(
                 ['street', 'city', 'cityLower', 'state', 'number',
                  'complement', 'neighborhood', 'postalCode'])
            && validRequiredString(request.resource.data.address.street, 160)
            && validRequiredString(request.resource.data.address.city, 100)
            && validRequiredString(request.resource.data.address.cityLower, 100)
            && request.resource.data.address.state in [
                 'AC', 'AL', 'AP', 'AM', 'BA', 'CE', 'DF', 'ES', 'GO',
                 'MA', 'MT', 'MS', 'MG', 'PA', 'PB', 'PR', 'PE', 'PI',
                 'RJ', 'RN', 'RS', 'RO', 'RR', 'SC', 'SP', 'SE', 'TO']
            && validOptionalAddressString('number', 20)
            && validOptionalAddressString('complement', 120)
            && validOptionalAddressString('neighborhood', 100)
            && (!('postalCode' in request.resource.data.address)
                || (request.resource.data.address.postalCode is string
                    && request.resource.data.address.postalCode.matches(
                         '^[0-9]{8}$')));
      }

      // Os nomes são os `storageName` do enum `Sport` do app, na mesma ordem.
      // A mesma lista existe no painel admin (`adminSportLabels`) e no Admin
      // SDK (`supportedSports`): esporte novo entra nos três, senão o admin
      // não consegue salvar o local.
      function validSports() {
        return request.resource.data.sports is list
            && request.resource.data.sports.size() >= 1
            && request.resource.data.sports.size() <= 16
            && request.resource.data.sports.toSet().size()
               == request.resource.data.sports.size()
            && request.resource.data.sports.toSet().hasOnly(
                 ['futebol', 'futsal', 'basquete', 'volei',
                  'handebol', 'tenis', 'tenisDeMesa', 'padel',
                  'futebolDeAreia', 'voleiDePraia', 'futevolei', 'beachTennis',
                  'corrida', 'ciclismo', 'caminhada', 'skate'])
            && request.resource.data.primarySport in request.resource.data.sports;
      }

      function validCoordinates() {
        return request.resource.data.coordinates is latlng
            && request.resource.data.coordinates.latitude() >= -90
            && request.resource.data.coordinates.latitude() <= 90
            && request.resource.data.coordinates.longitude() >= -180
            && request.resource.data.coordinates.longitude() <= 180;
      }

      function validPlaceImage(image) {
        return image is map
            && image.keys().hasOnly(['url', 'source'])
            && image.url is string
            && image.url.size() <= 2048
            && image.url.matches('^https://.+')
            && (!('source' in image)
                || (image.source is string && image.source.size() <= 200));
      }

      function validPlaceImages() {
        // Rules do not support list iteration. Validate the gallery bounds and
        // cover here; the Admin validates each remaining entry before writing.
        return !('images' in request.resource.data)
            || (request.resource.data.images is list
                && request.resource.data.images.size() > 0
                && request.resource.data.images.size() <= 8
                && validPlaceImage(request.resource.data.images[0])
                && request.resource.data.imageUrl
                   == request.resource.data.images[0].url);
      }

      function validPlaceAccess() {
        return (!('accessType' in request.resource.data)
                || request.resource.data.accessType in ['public', 'private'])
            && (!('contactPhone' in request.resource.data)
                || (request.resource.data.contactPhone is string
                    && request.resource.data.contactPhone.matches(
                         '^[1-9][0-9][0-9]{8,9}$')))
            && (!('accessType' in request.resource.data)
                || request.resource.data.accessType != 'private'
                || ('contactPhone' in request.resource.data
                    && request.resource.data.contactPhone is string
                    && request.resource.data.contactPhone.matches(
                         '^[1-9][0-9][0-9]{8,9}$')));
      }

      function validPlace() {
        return request.resource.data.keys().hasAll(
                 ['name', 'nameLower', 'description', 'address', 'sports',
                  'primarySport', 'coordinates', 'imageUrl', 'status',
                  'createdAt', 'updatedAt'])
            && request.resource.data.keys().hasOnly(
                 ['name', 'nameLower', 'description', 'address', 'sports',
                  'primarySport', 'coordinates', 'imageUrl', 'status',
                  'createdAt', 'updatedAt', 'images', 'accessType',
                  'contactPhone'])
            && validRequiredString(request.resource.data.name, 120)
            && validRequiredString(request.resource.data.nameLower, 120)
            && validRequiredString(request.resource.data.description, 1500)
            && validAddress()
            && validSports()
            && validCoordinates()
            && request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() > 0
            && request.resource.data.imageUrl.size() <= 2048
            && request.resource.data.imageUrl.matches('^https://.+')
            && validPlaceImages()
            && validPlaceAccess()
            && request.resource.data.status in ['active', 'inactive']
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp;
      }

      // Um usuário comum só consegue listar ativos porque a regra se aplica a
      // cada resultado potencial da query. `get` por ID mantém o contexto
      // histórico de Eventos e Mensagens, inclusive para locais inativos.
      allow get: if signedIn();
      allow list: if isAdmin()
                  || (signedIn() && resource.data.status == 'active');
      allow create: if isAdmin()
                    && validPlace()
                    && ('accessType' in request.resource.data)
                    && request.resource.data.status == 'inactive'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
                    && validPlace()
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Registros de suspensão são exclusivos do Admin SDK. Nem mesmo uma
    // sessão com claim administrativa recebe acesso direto: o painel usa a
    // Callable idempotente para não expor auditoria mínima, motivos ou o
    // protocolo pending/succeeded/failed ao cliente.
    match /adminOperations/{operationId} {
      allow read, write: if false;
    }

    // ── reports ──────────────────────────────────────────────────────
    // chore/lgpd. Denúncias de perfil, evento ou mensagem (Play, conteúdo
    // gerado por usuário; ECA Digital, arts. 28–30). Quem denuncia não lê
    // nada depois; só o Administrador lê e fecha.
    //
    // A cópia da mensagem denunciada é conferida com a mensagem real: os
    // Administradores não leem conversas, então o texto que chega a eles
    // precisa ser o que foi enviado, e não o que o denunciante digitou.
    // `priority` 0 é "envolve criança ou adolescente", analisada primeiro.
    match /reports/{reportId} {
      function eventPath(eventId) {
        return /databases/$(database)/documents/events/$(eventId);
      }

      function messagePath(conversationId, messageId) {
        return /databases/$(database)/documents/conversations/$(conversationId)/messages/$(messageId);
      }

      function validTarget(data) {
        return (data.targetType == 'user'
                && data.targetUid == data.targetId
                && exists(/databases/$(database)/documents/users/$(data.targetId)))
            || (data.targetType == 'event'
                && exists(eventPath(data.targetId))
                && get(eventPath(data.targetId)).data.creator.id
                   == data.targetUid)
            || (data.targetType == 'message'
                && data.conversationId is string
                && data.conversationId.size() > 0
                && request.auth.uid in get(/databases/$(database)/documents/conversations/$(data.conversationId)).data.members
                && exists(messagePath(data.conversationId, data.targetId))
                && get(messagePath(data.conversationId, data.targetId))
                     .data.senderId == data.targetUid
                && get(messagePath(data.conversationId, data.targetId))
                     .data.text == data.messageText);
      }

      function validReport() {
        let data = request.resource.data;
        return data.keys().hasAll(
                 ['reporterId', 'targetType', 'targetId', 'targetUid',
                  'reason', 'details', 'priority', 'status', 'createdAt'])
            && data.keys().hasOnly(
                 ['reporterId', 'targetType', 'targetId', 'targetUid',
                  'reason', 'details', 'priority', 'status', 'createdAt',
                  'conversationId', 'messageText'])
            && data.reporterId == request.auth.uid
            && data.targetType in ['user', 'event', 'message']
            && data.targetId is string
            && data.targetId.size() > 0
            && data.targetId.size() <= 200
            && data.targetUid is string
            && data.targetUid.size() > 0
            && data.targetUid != request.auth.uid
            && data.reason in ['harassment', 'hate', 'sexual', 'childSafety',
                               'violence', 'spam', 'fake', 'other']
            && data.details is string
            && data.details.size() <= 1000
            && ((data.reason == 'childSafety' && data.priority == 0)
                || (data.reason != 'childSafety' && data.priority == 1))
            && data.status == 'open'
            && data.createdAt == request.time
            && (data.targetType == 'message'
                || (!('conversationId' in data) && !('messageText' in data)))
            && validTarget(data);
      }

      // Fechar: só o status, quem fechou, quando, a nota e o prazo de
      // retenção (12 meses, apagado pela política de TTL em `expiresAt`).
      function validClose() {
        let data = request.resource.data;
        return changed().hasOnly(
                 ['status', 'resolvedAt', 'resolvedBy', 'resolution',
                  'expiresAt'])
            && resource.data.status == 'open'
            && data.status in ['resolved', 'dismissed']
            && data.resolvedAt == request.time
            && data.resolvedBy == request.auth.uid
            && data.resolution is string
            && data.resolution.size() <= 500
            && data.expiresAt is timestamp
            && data.expiresAt > request.time + duration.value(364, 'd')
            && data.expiresAt < request.time + duration.value(366, 'd');
      }

      allow create: if signedIn() && validReport();
      allow read: if isAdmin();
      allow update: if isAdmin() && validClose();
      allow delete: if false;
    }

    // ── ratings / ratingSummaries ────────────────────────────────────
    // Tarefa 14. Só a callable `submitEventRatings` (Admin SDK) grava: ela
    // confere o que as regras não conseguem — evento encerrado, autor que
    // participou, N participantes avaliados, nada repetido — e grava as
    // avaliações, os agregados e o `ratedBy` do evento numa transação.
    //
    // D13: comentários não são públicos e não há moderação. Ninguém lê
    // `ratings` pelo cliente; o que aparece na UI é a média, em
    // `ratingSummaries`. Sem `read`, o comentário não vaza nem para quem
    // inspeciona o tráfego.
    match /ratings/{ratingId} {
      allow read, write: if false;
    }

    // Agregados por alvo (`{targetType}_{targetId}`): contagem, soma e
    // contagem por estrela. Ficam fora de `users` e `places`, cujos
    // contratos estritos (`hasOnly`) não aceitam campo de nota.
    match /ratingSummaries/{summaryId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
