rules_version = '2';

// Regras de segurança do Firestore — COMPY.
//
// Estratégia: `signedIn()` autoriza **o app**, não **o usuário certo**. Como o
// app já tem uid real em todo lugar, cada coleção é restringida ao papel de
// quem escreve (dono do perfil, criador do evento, membro da conversa).
//
// Base: docs/roadmap-prioridade-alta.md → "Regras do Firestore — trabalho
// pendente". Cada bloco abaixo referencia a tarefa que o originou.
//
// Convenção deste arquivo:
//   - `delete` é negado por padrão. A única exceção é a exclusão de conta:
//     o dono apaga o próprio `users/{uid}`, o `private/contact` e a reserva
//     em `usernames/{username}`. Nenhuma outra coleção apaga nada.
//   - Campos ainda não implementados (`endedAt`) estão marcados com TODO e a
//     tarefa correspondente.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    /// Chaves que mudaram entre o estado atual e o escrito.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── users ────────────────────────────────────────────────────────
    // Tarefa 13. Perfis públicos: qualquer autenticado lê, só o dono escreve
    // o seu. `hasOnly` impede que o cliente despeje campos arbitrários no
    // documento (inclusive médias de avaliação forjadas — ver `ratings`).
    //
    // O e-mail **não** mora aqui: `read: if signedIn()` o entregaria a
    // qualquer autenticado, contrariando a RN-06. Ele vive em
    // `users/{uid}/private/contact`, no bloco aninhado no fim deste match.
    //
    // `nameLower` entra no contrato novo de pesquisa administrativa. A fase
    // transitória ainda aceita perfis legados sem ele, mas todo perfil novo o
    // recebe e um perfil que já o possui não pode removê-lo. O normalizador
    // pt-BR exato fica no cliente e no script confiável: Rules validam forma e
    // que uma troca de nome resulte em um `nameLower` presente.
    match /users/{userId} {
      function validProfile() {
        return request.resource.data.keys().hasOnly(
                 ['id', 'name', 'nameLower', 'handle', 'avatarUrl', 'createdAt',
                  'favoriteSports'])
            && request.resource.data.id == userId
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 60
            && validOptionalNameLower()
            && request.resource.data.handle is string
            && request.resource.data.handle.size() <= 21
            && validFavoriteSports();
      }

      function hasValidNameLower() {
        return 'nameLower' in request.resource.data.keys()
            && request.resource.data.nameLower is string
            && request.resource.data.nameLower.size() > 0
            && request.resource.data.nameLower.size() <= 60;
      }

      function validOptionalNameLower() {
        return !('nameLower' in request.resource.data.keys())
            || hasValidNameLower();
      }

      function preservesProfileIdentity() {
        return request.resource.data.handle == resource.data.handle
            && request.resource.data.createdAt == resource.data.createdAt;
      }

      function validNameLowerTransition() {
        return (!('nameLower' in resource.data.keys())
                || 'nameLower' in request.resource.data.keys())
            && (request.resource.data.name == resource.data.name
                || hasValidNameLower());
      }

      // Tarefa 13: no máximo 8 esportes (tamanho do enum `Sport`), lista de
      // strings — evita que `Sport.values.firstWhere` estoure na leitura.
      function validFavoriteSports() {
        return !('favoriteSports' in request.resource.data.keys())
            || (request.resource.data.favoriteSports is list
                && request.resource.data.favoriteSports.size() <= 8);
      }

      allow read: if signedIn();
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && validProfile()
                    && hasValidNameLower();
      allow update: if signedIn()
                    && request.auth.uid == userId
                    && validProfile()
                    && preservesProfileIdentity()
                    && validNameLowerTransition();
      // Exclusão de conta: o dono apaga o próprio perfil. Sem isto, o
      // documento sobrevive à conta e vira registro órfão de gente que
      // pediu para sair.
      allow delete: if signedIn() && request.auth.uid == userId;

      // ── users/{uid}/private ──────────────────────────────────────
      // Tarefa 13 (RN-06). Dados de contato — hoje só o e-mail. Subcoleção
      // porque as regras do documento pai não alcançam os filhos: é o que
      // permite o perfil continuar público e o contato não.
      //
      // Só o dono lê e escreve. Nenhuma tela do app lê este documento; ele
      // existe para o e-mail ter onde ficar sem virar dado público.
      match /private/{docId} {
        allow read, create, update, delete: if signedIn()
                                            && request.auth.uid == userId;
      }
    }

    // ── usernames ────────────────────────────────────────────────────
    // Tarefa 5. Índice de unicidade (doc id = username em minúsculo, dado
    // `{ uid }`).
    //
    // `read: if true` é decisão consciente, não resquício: `isUsernameAvailable()`
    // roda **antes** do login, no formulário de cadastro. O custo é expor a
    // lista de usernames — aceitável, já que username é público por natureza.
    //
    // `update` permitido quando o doc já pertence ao mesmo uid: sem isso o
    // re-cadastro do item 3 da tarefa 5 (`batch.set` sobre doc existente vira
    // update) estoura em PERMISSION_DENIED.
    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      // Exclusão de conta: só o dono da reserva a libera. Sem isto o
      // username fica preso para sempre — `update` exige ser do mesmo uid,
      // e esse uid não existe mais.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ── events ───────────────────────────────────────────────────────
    // Tarefa 12. Antes, qualquer autenticado editava qualquer evento — podia
    // mudar a data de um evento alheio, remover participantes ou inflar as
    // próprias vagas. Agora `update` tem dois caminhos distintos:
    //
    //   1. Criador edita os dados do evento (não pode trocar o dono).
    //   2. Qualquer autenticado entra no evento — e apenas isso: mexe só em
    //      `participants` + `participantIds` + `remainingSpots`, adiciona **a si
    //      mesmo** no fim dos dois arrays (o `arrayUnion` do `join()` sempre
    //      acrescenta ao fim) e decrementa exatamente uma vaga. Isso fecha a
    //      fraude do join apontada em proximos-passos.md: não dá para aumentar
    //      `remainingSpots` sem remover participante, nem vice-versa.
    match /events/{eventId} {
      function isCreator() {
        return signedIn() && resource.data.creator.id == request.auth.uid;
      }

      function ownerUnchanged() {
        return request.resource.data.creator.id == resource.data.creator.id;
      }

      function spotsCoherent() {
        return request.resource.data.remainingSpots >= 0
            && request.resource.data.remainingSpots
               <= request.resource.data.totalSpots;
      }

      function eventPlacePath(placeId) {
        return /databases/$(database)/documents/places/$(placeId);
      }

      function newPlaceSnapshotMatchesCurrentPlace() {
        let place = get(eventPlacePath(request.resource.data.placeId)).data;
        return request.resource.data.placeId is string
            && request.resource.data.placeId.size() > 0
            && request.resource.data.placeSnapshot is map
            && request.resource.data.placeSnapshot.keys().hasAll(
                 ['name', 'address', 'coordinates'])
            && request.resource.data.placeSnapshot.keys().hasOnly(
                 ['name', 'address', 'coordinates'])
            && exists(eventPlacePath(request.resource.data.placeId))
            && place.status == 'active'
            && request.resource.data.sport in place.sports
            && request.resource.data.placeSnapshot.name == place.name
            && request.resource.data.placeSnapshot.address == place.address
            && request.resource.data.placeSnapshot.coordinates is latlng
            && request.resource.data.placeSnapshot.coordinates
               == place.coordinates
            && request.resource.data.coordinates is latlng
            && request.resource.data.coordinates == place.coordinates
            && request.resource.data.geohash is string
            && request.resource.data.geohash.size() == 9
            && request.resource.data.location
               == place.name + ', ' + place.address.city;
      }

      function historicalEventFieldsUnchanged() {
        return !changed().hasAny(['sport', 'placeId', 'placeSnapshot']);
      }

      // `participantIds` é o array de uids que a seção "Participando"
      // consulta (`arrayContains`) — `participants`, sendo array de mapas, não
      // é consultável. Por isso ele entra na regra: se pudesse crescer sozinho,
      // qualquer um se enfiaria na lista de qualquer evento sem ocupar vaga, e
      // o app mostraria eventos alheios como "meus".
      //
      // O `get(..., [])` cobre documentos anteriores à tarefa 12, que não têm
      // o campo: sem o default a expressão estouraria e eles ficariam
      // impossíveis de participar. O primeiro join cria o array.
      function joinedIdsBefore() {
        return resource.data.get('participantIds', []);
      }

      // TODO(tarefa 14): abrir a exceção do encerramento automático —
      // qualquer participante pode gravar `endedAt`/`endedAutomatically`
      // desde que `endsAt` + 1h já tenha passado e `endedAt` ainda seja nulo.
      function isJoin() {
        return signedIn()
            && changed().hasOnly(
                 ['participants', 'participantIds', 'remainingSpots'])
            && request.resource.data.participants.size()
               == resource.data.participants.size() + 1
            && request.resource.data
                 .participants[resource.data.participants.size()].id
               == request.auth.uid
            && request.resource.data.participantIds.size()
               == joinedIdsBefore().size() + 1
            && request.resource.data
                 .participantIds[joinedIdsBefore().size()] == request.auth.uid
            && request.resource.data.remainingSpots
               == resource.data.remainingSpots - 1
            && request.resource.data.remainingSpots >= 0;
      }

      allow read: if signedIn();
      // Criar evento em nome de outro é negado duas vezes: pelo `creator.id` e
      // pelo `participantIds`, que na criação só pode conter o próprio uid —
      // ninguém inscreve terceiros num evento que acabou de inventar.
      allow create: if signedIn()
                    && request.resource.data.creator.id == request.auth.uid
                    && request.resource.data.participantIds
                       == [request.auth.uid]
                    && request.resource.data.totalSpots is int
                    && request.resource.data.totalSpots > 0
                    && spotsCoherent()
                    && newPlaceSnapshotMatchesCurrentPlace();
      allow update: if (isCreator()
                       && ownerUnchanged()
                       && spotsCoherent()
                       && historicalEventFieldsUnchanged())
                    || isJoin();
      allow delete: if false;
    }

    // ── conversations / messages ─────────────────────────────────────
    // Tarefa 9. Antes, qualquer autenticado lia e escrevia qualquer conversa
    // privada de qualquer pessoa — o pior default possível num app de chat.
    // O documento já tem o array `members`, então dá para apertar sem perder
    // funcionalidade: a query paginada já filtra por
    // `where('members', arrayContains: userId)`.
    //
    // As mensagens validam a associação com um `get()` no documento pai — custa
    // uma leitura por operação. A alternativa (desnormalizar `members` em cada
    // mensagem) foi descartada por enquanto: exigiria mudar o schema de
    // `sendMessage` e o volume de mensagens do MVP não justifica.
    match /conversations/{conversationId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      function isMemberOfParent() {
        return signedIn()
            && request.auth.uid in get(
                 /databases/$(database)/documents/conversations/$(conversationId)
               ).data.members;
      }

      allow read: if isMember();

      // Só se cria conversa incluindo a si mesmo — ninguém abre conversa entre
      // terceiros. Conversas são 1:1 (a entidade `Conversation` resolve um
      // único `peer`).
      allow create: if signedIn()
                    && request.resource.data.members is list
                    && request.resource.data.members.size() == 2
                    && request.auth.uid in request.resource.data.members;

      // Depois de criada, `members` é imutável: só o rodapé da conversa muda.
      allow update: if isMember()
                    && changed().hasOnly(
                         ['lastMessage', 'lastMessageAt', 'unreadCounts']);
      allow delete: if false;

      match /messages/{messageId} {
        function hasActivePlaceForMessage() {
          return request.resource.data.placeId is string
              && request.resource.data.placeId.size() > 0
              && exists(/databases/$(database)/documents/places/$(request.resource.data.placeId))
              && get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.status == 'active';
        }

        function validPlaceMessageSnapshot() {
          return request.resource.data.keys().hasAll(
                   ['senderId', 'text', 'sentAt', 'placeId', 'placeSnapshot'])
              && request.resource.data.keys().hasOnly(
                   ['senderId', 'text', 'sentAt', 'placeId', 'placeSnapshot'])
              && hasActivePlaceForMessage()
              && request.resource.data.placeSnapshot is map
              && request.resource.data.placeSnapshot.keys().hasAll(
                   ['name', 'imageUrl', 'primarySport'])
              && request.resource.data.placeSnapshot.keys().hasOnly(
                   ['name', 'imageUrl', 'primarySport'])
              && request.resource.data.placeSnapshot.name
                 == get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.name
              && request.resource.data.placeSnapshot.imageUrl
                 == get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.imageUrl
              && request.resource.data.placeSnapshot.primarySport
                 == get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.primarySport;
        }

        allow read: if isMemberOfParent();
        allow create: if isMemberOfParent()
                      && request.resource.data.senderId == request.auth.uid
                      && ((!('placeId' in request.resource.data)
                           && !('placeSnapshot' in request.resource.data))
                          || validPlaceMessageSnapshot());
        // Mensagem enviada não se edita nem se apaga.
        allow update, delete: if false;
      }
    }

    // ── places ───────────────────────────────────────────────────────
    // Contrato final de Locais Esportivos. Novos eventos e mensagens de local
    // precisam usar documentos ativos e snapshots validados no commit.
    match /places/{placeId} {
      function validRequiredString(value, maximum) {
        return value is string && value.size() > 0 && value.size() <= maximum;
      }

      function validOptionalAddressString(field, maximum) {
        return !(field in request.resource.data.address)
            || (request.resource.data.address[field] is string
                && request.resource.data.address[field].size() > 0
                && request.resource.data.address[field].size() <= maximum);
      }

      function validAddress() {
        return request.resource.data.address is map
            && request.resource.data.address.keys().hasAll(
                 ['street', 'city', 'cityLower', 'state'])
            && request.resource.data.address.keys().hasOnly(
                 ['street', 'city', 'cityLower', 'state', 'number',
                  'complement', 'neighborhood', 'postalCode'])
            && validRequiredString(request.resource.data.address.street, 160)
            && validRequiredString(request.resource.data.address.city, 100)
            && validRequiredString(request.resource.data.address.cityLower, 100)
            && request.resource.data.address.state in [
                 'AC', 'AL', 'AP', 'AM', 'BA', 'CE', 'DF', 'ES', 'GO',
                 'MA', 'MT', 'MS', 'MG', 'PA', 'PB', 'PR', 'PE', 'PI',
                 'RJ', 'RN', 'RS', 'RO', 'RR', 'SC', 'SP', 'SE', 'TO']
            && validOptionalAddressString('number', 20)
            && validOptionalAddressString('complement', 120)
            && validOptionalAddressString('neighborhood', 100)
            && (!('postalCode' in request.resource.data.address)
                || (request.resource.data.address.postalCode is string
                    && request.resource.data.address.postalCode.matches(
                         '^[0-9]{8}$')));
      }

      function validSports() {
        return request.resource.data.sports is list
            && request.resource.data.sports.size() >= 1
            && request.resource.data.sports.size() <= 8
            && request.resource.data.sports.toSet().size()
               == request.resource.data.sports.size()
            && request.resource.data.sports.toSet().hasOnly(
                 ['futebol', 'basquete', 'volei', 'tenisDeMesa', 'futsal',
                  'corrida', 'ciclismo', 'caminhada'])
            && request.resource.data.primarySport in request.resource.data.sports;
      }

      function validCoordinates() {
        return request.resource.data.coordinates is latlng
            && request.resource.data.coordinates.latitude() >= -90
            && request.resource.data.coordinates.latitude() <= 90
            && request.resource.data.coordinates.longitude() >= -180
            && request.resource.data.coordinates.longitude() <= 180;
      }

      function validPlace() {
        return request.resource.data.keys().hasAll(
                 ['name', 'nameLower', 'description', 'address', 'sports',
                  'primarySport', 'coordinates', 'imageUrl', 'status',
                  'createdAt', 'updatedAt'])
            && request.resource.data.keys().hasOnly(
                 ['name', 'nameLower', 'description', 'address', 'sports',
                  'primarySport', 'coordinates', 'imageUrl', 'status',
                  'createdAt', 'updatedAt'])
            && validRequiredString(request.resource.data.name, 120)
            && validRequiredString(request.resource.data.nameLower, 120)
            && validRequiredString(request.resource.data.description, 1500)
            && validAddress()
            && validSports()
            && validCoordinates()
            && request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() > 0
            && request.resource.data.imageUrl.size() <= 2048
            && request.resource.data.imageUrl.matches('^https://.+')
            && request.resource.data.status in ['active', 'inactive']
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp;
      }

      // Um usuário comum só consegue listar ativos porque a regra se aplica a
      // cada resultado potencial da query. `get` por ID mantém o contexto
      // histórico de Eventos e Mensagens, inclusive para locais inativos.
      allow get: if signedIn();
      allow list: if isAdmin()
                  || (signedIn() && resource.data.status == 'active');
      allow create: if isAdmin()
                    && validPlace()
                    && request.resource.data.status == 'inactive'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
                    && validPlace()
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Registros de suspensão são exclusivos do Admin SDK. Nem mesmo uma
    // sessão com claim administrativa recebe acesso direto: o painel usa a
    // Callable idempotente para não expor auditoria mínima, motivos ou o
    // protocolo pending/succeeded/failed ao cliente.
    match /adminOperations/{operationId} {
      allow read, write: if false;
    }

    // ── ratings ──────────────────────────────────────────────────────
    // Tarefa 14. Coleção nova — antes caía no deny-by-default.
    //
    // D13: comentários não são públicos e não há moderação. Leitura é negada
    // por completo; o que aparece na UI é a média desnormalizada no alvo,
    // gravada junto da avaliação. Sem `read`, o comentário não vaza nem para
    // quem inspeciona o tráfego.
    //
    // D12: nota abaixo de 3 estrelas exige justificativa — vale para os dois
    // alvos ainda suportados, e é validado aqui além da UI. Avaliações de
    // Local Esportivo ficam fora do escopo até existir um sistema real.
    //
    // Avaliação enviada não se reescreve: é a única garantia de integridade da
    // média sem backend.
    match /ratings/{ratingId} {
      function validRating() {
        return request.resource.data.keys().hasAll(
                 ['eventId', 'fromUid', 'targetType', 'targetId', 'stars',
                  'createdAt'])
            && request.resource.data.keys().hasOnly(
                 ['eventId', 'fromUid', 'targetType', 'targetId', 'stars',
                  'comment', 'createdAt'])
            && request.resource.data.targetType in ['user', 'event']
            && request.resource.data.stars is int
            && request.resource.data.stars >= 1
            && request.resource.data.stars <= 5
            && validComment();
      }

      function hasComment() {
        return 'comment' in request.resource.data.keys()
            && request.resource.data.comment is string
            && request.resource.data.comment.size() > 0;
      }

      function validComment() {
        return (!('comment' in request.resource.data.keys())
                || (request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 500))
            // D12: menos de 3 estrelas exige justificativa.
            && (request.resource.data.stars >= 3 || hasComment());
      }

      // TODO(tarefa 14): avaliar se vale o custo de dois `get()` para exigir
      // que o evento esteja encerrado (`endedAt != null`) e que o autor tenha
      // participado dele (`request.auth.uid in participantIds`). O
      // `participantIds` já existe desde a tarefa 12; falta o `endedAt`.
      allow read: if false;
      allow create: if signedIn()
                    && request.resource.data.fromUid == request.auth.uid
                    && validRating();
      allow update, delete: if false;
    }
  }
}
